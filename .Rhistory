library(knitr)
library(tidyverse)
library(plotly)
library(broom)
opts_chunk$set(echo = TRUE)
# ENTER CODE FOR TASK 1 HERE
# Data wrangling
# Removing NAs for leaf number to ensure a clean plot
palm_leaves_clean <- palmtrees %>%
filter(!is.na(max_leaf_number))
# Load the dataset from folder
palmtrees <- read_csv("palmtrees.csv")
# ENTER CODE FOR TASK 1 HERE
# Data wrangling
# Removing NAs for leaf number to ensure a clean plot
palm_leaves_clean <- palmtrees %>%
filter(!is.na(max_leaf_number))
# Code for plot 1: Boxplot comparing leaf counts across subfamilies
p1 <- ggplot(palm_leaves_clean, aes(x = palm_subfamily, y = max_leaf_number, fill = palm_subfamily)) +
geom_boxplot() +
labs(title = "Max Leaf Number by Palm Subfamily",
x = "Palm Subfamily",
y = "Maximum Number of Leaves") +
theme_minimal() +
theme(legend.position = "none") # Legend is redundant here since x-axis is labeled
# Convert to interactive plotly object
ggplotly(p1)
# ENTER CODE FOR TASK 1 HERE
# Data wrangling: Filter out missing values for height and diameter
palm_growth_clean <- palmtrees %>%
filter(!is.na(max_stem_height_m), !is.na(max_stem_dia_cm))
# Code for plot 2: Scatterplot of Height vs. Diameter colored by subfamily
p2 <- ggplot(palm_growth_clean, aes(x = max_stem_dia_cm, y = max_stem_height_m, color = palm_subfamily)) +
geom_point(alpha = 0.6) +
labs(title = "Relationship Between Stem Diameter and Height",
x = "Max Stem Diameter (cm)",
y = "Max Stem Height (m)",
color = "Subfamily") +
theme_minimal()
# Convert to interactive plotly object
ggplotly(p2)
# ENTER CODE FOR TASK 2 HERE
# Linear model predicting max_leaf_number
model <- lm(max_leaf_number ~ average_fruit_length_cm + average_fruit_width_cm +
max_stem_height_m + max_stem_dia_cm, data = palmtrees)
# Create tidied model with confidence intervals and filter out the intercept
model_tidied <- tidy(model, conf.int = TRUE) %>%
filter(term != "(Intercept)")
# Create a coefficient plot
ggplot(model_tidied, aes(x = estimate, y = term)) +
geom_pointrange(aes(xmin = conf.low, xmax = conf.high)) +
geom_vline(xintercept = 0, color = "red", linetype = "dashed") + # Reference line at zero
labs(title = "Coefficient Plot: Predictors of Max Leaf Number",
subtitle = "Error bars represent 95% confidence intervals",
x = "Estimated Coefficient (Impact on Leaf Count)",
y = "Predictor Variable") +
theme_minimal()
# ENTER CODE FOR TASK 3 HERE
# Create new data: vary max_stem_dia_cm across its full range
# Keep all other predictors constant at their mean value
newdata <- tibble(
max_stem_dia_cm = seq(min(palmtrees$max_stem_dia_cm, na.rm = TRUE),
max(palmtrees$max_stem_dia_cm, na.rm = TRUE),
length.out = 100),
average_fruit_length_cm = mean(palmtrees$average_fruit_length_cm, na.rm = TRUE),
average_fruit_width_cm = mean(palmtrees$average_fruit_width_cm, na.rm = TRUE),
max_stem_height_m = mean(palmtrees$max_stem_height_m, na.rm = TRUE)
)
# Predict the values using augment
predicted_values <- augment(model, newdata = newdata, se_fit = TRUE) %>%
mutate(.lower = .fitted - 1.96 * .se.fit,
.upper = .fitted + 1.96 * .se.fit)
# Plot the marginal effects
ggplot(predicted_values, aes(x = max_stem_dia_cm, y = .fitted)) +
geom_line(color = "blue", size = 1) +
geom_ribbon(aes(ymin = .lower, ymax = .upper), fill = "blue", alpha = 0.2) +
labs(title = "Marginal Effect of Stem Diameter on Max Leaf Number",
subtitle = "Holding fruit size and stem height constant at their mean",
x = "Max Stem Diameter (cm)",
y = "Predicted Max Number of Leaves") +
theme_minimal()
# ENTER CODE FOR TASK 3 HERE
# Create new data: vary max_stem_dia_cm across its full range
# Keep all other predictors constant at their mean value
newdata <- tibble(
max_stem_dia_cm = seq(min(palmtrees$max_stem_dia_cm, na.rm = TRUE),
max(palmtrees$max_stem_dia_cm, na.rm = TRUE),
length.out = 100),
average_fruit_length_cm = mean(palmtrees$average_fruit_length_cm, na.rm = TRUE),
average_fruit_width_cm = mean(palmtrees$average_fruit_width_cm, na.rm = TRUE),
max_stem_height_m = mean(palmtrees$max_stem_height_m, na.rm = TRUE)
)
# Predict the values using augment
predicted_values <- augment(model, newdata = newdata, se_fit = TRUE) %>%
mutate(.lower = .fitted - 1.96 * .se.fit,
.upper = .fitted + 1.96 * .se.fit)
# Plot the marginal effects
ggplot(predicted_values, aes(x = max_stem_dia_cm, y = .fitted)) +
geom_line(color = "blue", linewidth = 1) +
geom_ribbon(aes(ymin = .lower, ymax = .upper), fill = "blue", alpha = 0.2) +
labs(title = "Marginal Effect of Stem Diameter on Max Leaf Number",
subtitle = "Holding fruit size and stem height constant at their mean",
x = "Max Stem Diameter (cm)",
y = "Predicted Max Number of Leaves") +
theme_minimal()
