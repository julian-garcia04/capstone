library(ggplot2)
library(dplyr)
library(palmerpenguins)
# Once the palmerpenguins package is loaded, we can access the data through the "penguins" object
head(penguins)
# Data wrangling
## Row {height=600}
#| title: Bill Length vs. Bill Depth by Species
ggplot(penguins, aes(x = bill_length_mm, y = bill_depth_mm, color = species)) +
geom_point(alpha = 0.7) +
# Annotation: Highlighting the Gentoo cluster
annotate("rect", xmin = 42, xmax = 60, ymin = 13, ymax = 18,
alpha = 0.1, fill = "blue", color = "blue") +
annotate("text", x = 51, y = 12.5, label = "Gentoo Cluster", color = "blue", fontface = "bold") +
theme_minimal()
## Row {height=400}
#| title: Body Mass Distribution by Island
ggplot(penguins, aes(x = island, y = body_mass_g, fill = island)) +
geom_boxplot() +
# Annotation: Arrow pointing to Biscoe's high median
annotate("segment", x = 1, xend = 1, y = 5500, yend = 4800,
arrow = arrow(length = unit(0.2, "cm")), color = "black") +
annotate("text", x = 1, y = 5700, label = "Highest Median Mass", size = 3) +
theme_minimal()
#| title: Flipper Length by Species
ggplot(penguins, aes(x = species, y = flipper_length_mm, fill = species)) +
geom_violin() +
# Annotation: Horizontal line showing the 200mm threshold
geom_hline(yintercept = 200, linetype = "dashed", color = "red") +
annotate("text", x = 0.6, y = 203, label = "200mm Threshold", color = "red", size = 3) +
theme_minimal()
